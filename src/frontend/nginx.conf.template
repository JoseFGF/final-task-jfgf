server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # NGINX_LOCAL_RESOLVERS lo genera el propio entrypoint oficial de la
    # imagen (15-local-resolvers.envsh, activado con
    # NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 en el Dockerfile) leyendo los
    # nameservers reales de /etc/resolv.conf del contenedor. Así funciona
    # igual en docker-compose (DNS embebido de Docker, 127.0.0.11) y en
    # Railway (su DNS interno) sin hardcodear un resolver público: un IP
    # público fijo (p.ej. 1.1.1.1) puede no ser alcanzable por egress
    # restringido en la red privada del PaaS, dejando la petición colgada.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;

    # `OrderApiService` (src/app/orders/order-api.service.ts) llama a rutas
    # relativas ("/api/v1/..."), es decir, mismo origen que el frontend. Sin
    # este proxy, esas llamadas irían al propio contenedor de nginx (404) en
    # vez de al backend.
    location /api/ {
        # IMPORTANTE: cuando proxy_pass usa una variable, nginx NO reescribe
        # el URI (no hace el "reemplazar el prefijo de location" que sí hace
        # con un proxy_pass literal) — reenvía el URI original del cliente
        # tal cual, sin usar ningún sufijo de path aquí. Se descubrió este
        # comportamiento de la manera dura: con "proxy_pass $backend_upstream/api/;"
        # nginx enviaba literalmente "/api/" al backend (descartando
        # "v1/orders"), dando 401/404 en vez de proxyar la ruta real. La
        # solución correcta es NO añadir ningún path tras la variable — el
        # URI del cliente ya es exactamente "/api/v1/..." y coincide con lo
        # que el backend espera, así que se reenvía sin modificar.
        set $backend_upstream ${BACKEND_SCHEME}://${BACKEND_ORIGIN};
        proxy_pass $backend_upstream;
        proxy_ssl_verify off;
        proxy_ssl_server_name on;

        # Railway (y otros PaaS con edge compartido) enrutan por el header
        # Host: hay que enviar el dominio del backend, no el del cliente
        # original ($host), o el edge no sabe a qué servicio dirigir la
        # petición y responde 404 "Application not found".
        proxy_set_header Host ${BACKEND_ORIGIN};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_pass_request_headers on;
    }

    # SPA de Angular con rutas (/orders, /orders/:id, ...): si el archivo o
    # directorio solicitado no existe físicamente, se sirve index.html para
    # que el router de Angular resuelva la ruta (evita 404 al recargar).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
